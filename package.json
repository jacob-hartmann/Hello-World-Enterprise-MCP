{
  "name": "hello-world-enterprise-mcp",
  "version": "1.0.0",
  "description": "A parody MCP server demonstrating enterprise over-engineering of 'Hello World'",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hello-world-enterprise-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --require dotenv/config src/index.ts",
    "build": "tsup",
    "start": "node -r dotenv/config dist/index.js",
    "inspect": "mcp-inspector tsx --require dotenv/config src/index.ts",
    "inspect:dist": "pnpm run build && mcp-inspector node -r dotenv/config dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hello-world",
    "enterprise",
    "parody",
    "ai",
    "claude"
  ],
  "author": "Jacob Hartmann <foss@jacobhartmann.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacob-hartmann/hello-world-enterprise-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jacob-hartmann/hello-world-enterprise-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/inspector": "0.22.0",
    "@types/node": "25.9.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
